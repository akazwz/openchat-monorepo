{
	"name": "@heveta/electron",
	"version": "0.3.0",
	"private": true,
	"description": "Heveta desktop for macOS",
	"main": "build/main.js",
	"scripts": {
		"dev": "pnpm build && electron .",
		"build": "pnpm typecheck && node scripts/build.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"package:macos": "pnpm typecheck && node scripts/package.mjs",
		"install:macos": "pnpm package:macos && node scripts/install.mjs"
	},
	"dependencies": {
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@electron/fuses": "2.1.3",
		"@electron/osx-sign": "2.7.1",
		"@electron/packager": "20.3.0",
		"@types/node": "^26.6.2",
		"@types/ws": "^8.18.2",
		"electron": "44.5.1",
		"esbuild": "0.28.2",
		"node-api-headers": "1.9.0"
	},
	"productName": "Heveta Electron"
}
