# Models are called through the AI binding (read with the OpenAI SDK); no API
# token is needed. Defaults live in src/config.ts.
# Set up Cloudflare AI Gateway credits or a default BYOK key in your account.
# Web search and page fetch (free within rate limits): https://tinyfish.ai
TINYFISH_API_KEY=
# Takes over web search and page fetch beyond TinyFish's limits (paid per token): https://jina.ai
JINA_API_KEY=


# Cloudflare Realtime TURN key for native remote desktop (server-side only).
TURN_KEY_ID=
TURN_API_TOKEN=
